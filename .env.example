# LecFaka Store - 插件商店与授权服务器

# 数据库
DATABASE_URL=postgresql+asyncpg://lecfaka:lecfaka123@localhost:5432/lecfaka_store

# 密钥（生产环境请修改！）
SECRET_KEY=store-secret-key-change-this
DEBUG=true

# 站点
SITE_NAME=LecFaka Store
SITE_URL=https://plugins.leclee.top

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ==================== 支付配置 ====================

# 易支付 (EasyPay)
# 留空表示不启用，购买将直接成功（仅测试用）
EPAY_URL=
EPAY_PID=
EPAY_KEY=

# 支付订单过期时间（分钟）
PAYMENT_EXPIRE_MINUTES=30

# 预留：USDT 支付
# USDT_API_URL=
# USDT_API_KEY=
# USDT_WALLET_ADDRESS=

# 预留：支付宝正版支付
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
